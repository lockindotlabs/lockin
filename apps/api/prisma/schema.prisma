generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id // Clerk user ID
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  settings        UserSettings?
  projects        Project[]
  plans           Plan[]
  tasks           Task[]
  focusSessions   FocusSession[]
  extensionTokens ExtensionToken[]
}

model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  name       String    @default("Extension")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme           String   @default("system")
  language        String   @default("en")
  // Extension settings — synced with Chrome extension
  blocklistHard   String[] @default([])
  blocklistSoft   String[] @default([])
  hudStyle        String   @default("pill+ring")
  reminderStyle   String   @default("banner")
  blockTone       String   @default("calm")
  popupView       String   @default("standard")
  defaultDuration Int      @default(25)
  tabGuard        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  plans       Plan[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name          String
  description   String?
  goal          String?
  completion    String?
  status        PlanStatus     @default(PLANNING)
  startDate     DateTime?
  endDate       DateTime?
  tasks         Task[]
  focusSessions FocusSession[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Task {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId          String?
  plan            Plan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  dueDate         DateTime?
  durationMinutes Int?
  order           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model FocusSession {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String?
  plan             Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  startedAt        DateTime        @default(now())
  endedAt          DateTime?
  duration         Int?
  plannedDuration  Int?
  overtimeDuration Int?            @default(0)
  completionType   CompletionType?
  tasksSnapshot    Json?
  slipCount        Int?            @default(0)
  createdAt        DateTime        @default(now())
}

enum CompletionType {
  EARLY
  NORMAL
  OVERTIME
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PlanStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
