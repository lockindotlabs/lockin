generator client {
  provider = "prisma-client"
  output   = "../../../packages/db/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id // Clerk user ID
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  settings        UserSettings?
  projects        Project[]
  plans           Plan[]
  planSteps       PlanStep[]
  chats           Chat[]
  tasks           Task[]
  focusSessions   FocusSession[]
  extensionTokens ExtensionToken[]
}

model Chat {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String     @default("New chat")
  messages  Json       @default("[]")
  status    ChatStatus @default(IDLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  name       String    @default("Extension")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String   @default("system")
  language  String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  color       String?
  plans       Plan[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plan {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId             String?
  project               Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name                  String
  description           String?
  goal                  String?
  completion            String?
  status                PlanStatus         @default(PLANNING)
  source                PlanSource         @default(MANUAL)
  aiMode                PlanAiMode         @default(MANUAL)
  breakdownIntensity    BreakdownIntensity @default(NORMAL)
  totalEstimatedMinutes Int                @default(0)
  startDate             DateTime?
  endDate               DateTime?
  deletedAt             DateTime?
  steps                 PlanStep[]
  focusSessions         FocusSession[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId, deletedAt])
}

model Task {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  dueDate         DateTime?
  durationMinutes Int?
  order           Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model PlanStep {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String
  plan             Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  status           PlanStepStatus @default(TODO)
  dueDate          DateTime?
  estimatedMinutes Int            @default(30)
  order            Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([planId])
  @@index([planId, order])
}

model FocusSession {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId           String?
  plan             Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  startedAt        DateTime        @default(now())
  endedAt          DateTime?
  duration         Int?
  plannedDuration  Int?
  overtimeDuration Int?            @default(0)
  completionType   CompletionType?
  tasksSnapshot    Json?
  slipCount        Int?            @default(0)
  createdAt        DateTime        @default(now())
}

enum CompletionType {
  EARLY
  NORMAL
  OVERTIME
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PlanStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PlanStepStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum PlanSource {
  MANUAL
  AI
}

enum PlanAiMode {
  MANUAL
  ASSISTED
}

enum BreakdownIntensity {
  LOW_ENERGY
  NORMAL
  HIGH_ENERGY
}

enum ChatStatus {
  IDLE
  STREAMING
  ERROR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
