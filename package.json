{
  "name": "lockin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "pnpm db:generate && turbo build",
    "start": "pnpm --filter web start",
    "build:web": "pnpm db:generate && turbo build --filter=web",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "postinstall": "pnpm db:generate",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test"
  },
  "prisma": {
    "seed": "tsx apps/api/prisma/seed.ts"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.8.0",
    "turbo": "^2.8.17",
    "tsx": "^4.19.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
